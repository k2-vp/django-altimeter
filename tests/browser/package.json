{
  "name": "altimeter-browser-tests",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit && node node_modules/typescript-asgi/bin/tsc -p tsconfig.asgi.json && tsc -p tsconfig.wsgi.json",
    "install:browser": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/bun": "1.3.14",
    "axios": "1.21.0",
    "posthog-js": "1.444.0",
    "typescript": "5.9.3",
    "typescript-asgi": "npm:typescript@6.0.3",
    "vitest": "5.0.5"
  }
}
