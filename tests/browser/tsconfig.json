{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "axios": ["./node_modules/axios"],
      "posthog-js": ["./node_modules/posthog-js"]
    },
    "types": ["bun", "node"]
  },
  "include": ["./**/*.ts", "../../src/django_altimeter/browser/**/*.ts", "../../reference/browser/**/*.ts"]
}
